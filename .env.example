# Copy to .env and fill in your values

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# MongoDB
MONGODB_USER=
MONGODB_PASS=

# RabbitMQ
RABBITMQ_USER=
