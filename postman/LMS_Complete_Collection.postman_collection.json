                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.loanId) pm.collectionVariables.set('loanId', jsonData.loanId);",
                                    "if (jsonData.id) pm.collectionVariables.set('loanId', jsonData.id);"
                                ],
                                "type": "text/javascript"
